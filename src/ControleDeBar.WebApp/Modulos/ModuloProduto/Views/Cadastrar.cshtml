@using ControleDeBar.WebApp.Modulos.ModuloProduto
@{
    Layout = "_Layout";
    ViewBag.Titulo = "Cadastro de Produto";
}

@model CadastrarProdutoViewModel;

<form class="card border-primary-subtle shadow-sm mx-auto p-4"
      style="max-width: 620px;"
      asp-action="Cadastrar"
      method="post">

    <div asp-validation-summary="ModelOnly"
         class="text-danger small fw-semibold mb-3"></div>

    <div class="mb-3">
        <label asp-for="Nome"
               class="form-label fw-semibold text-primary text-uppercase small">
            Nome
        </label>

        <input asp-for="Nome" class="form-control">

        <span asp-validation-for="Nome"
              class="text-danger small fw-semibold"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Preco"
               class="form-label fw-semibold text-primary text-uppercase small">
            Preço
        </label>

        <input asp-for="Preco"
               class="form-control"
               type="number"
               min="0.01"
               step="0.01">

        <span asp-validation-for="Preco"
              class="text-danger small fw-semibold"></span>
    </div>

    <div class="d-flex justify-content-end gap-2 mt-4">
        <a class="btn btn-outline-primary rounded-pill px-4"
           asp-action="Listar">
            Voltar
        </a>

        <button class="btn btn-primary rounded-pill px-4" type="submit">
            Confirmar
        </button>
    </div>
</form>
