@using ControleDeBar.WebApp.Modulos.ModuloPedido

@{
    Layout = "_Layout";
    ViewBag.Titulo = "Adicionar Pedido";
}

@model AdicionarPedidoViewModel;

<form class="card border-primary-subtle shadow-sm mx-auto p-4"
      style="max-width: 620px;"
      asp-action="Adicionar"
      method="post">

    <input asp-for="ContaId" type="hidden">

    <div asp-validation-summary="ModelOnly"
         class="text-danger small fw-semibold mb-3"></div>

    <div class="mb-3">
        <label asp-for="ProdutoId"
               class="form-label fw-semibold text-primary text-uppercase small">
            Produto
        </label>

        <select asp-for="ProdutoId"
                asp-items="Model.Produtos"
                class="form-select">
            <option value="">Selecione um produto</option>
        </select>

        <span asp-validation-for="ProdutoId"
              class="text-danger small fw-semibold"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Quantidade"
               class="form-label fw-semibold text-primary text-uppercase small">
            Quantidade
        </label>

        <input asp-for="Quantidade"
               class="form-control"
               type="number"
               min="1"
               step="1">

        <span asp-validation-for="Quantidade"
              class="text-danger small fw-semibold"></span>
    </div>

    <div class="d-flex justify-content-end gap-2 mt-4">
        <a class="btn btn-outline-primary rounded-pill px-4"
           asp-controller="Conta"
           asp-action="Detalhes"
           asp-route-id="@Model.ContaId">
            Voltar
        </a>

        <button class="btn btn-primary rounded-pill px-4"
                type="submit">
            Adicionar
        </button>
    </div>
</form>
