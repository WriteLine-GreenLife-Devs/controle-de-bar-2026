@{
    Layout = "_Layout";
    ViewBag.Titulo = "Cadastro de Mesa";
}

@model CadastrarMesaViewModel;

<form class="card border-primary-subtle shadow-sm mx-auto p-4" style="max-width: 620px;" asp-action="Cadastrar" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger small fw-semibold mb-3"></div>

    <div class="mb-3">
        <label asp-for="Numero" class="form-label fw-semibold text-primary text-uppercase small">Número</label>
        <input asp-for="Numero" type="number" class="form-control">
        <span asp-validation-for="Numero" class="text-danger small fw-semibold"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Lugares" class="form-label fw-semibold text-primary text-uppercase small">Lugares</label>
        <input asp-for="Lugares" type="number" class="form-control">
        <span asp-validation-for="Lugares" class="text-danger small fw-semibold"></span>
    </div>

    <div class="d-flex justify-content-end gap-2 mt-4">
        <a class="btn btn-outline-primary rounded-pill px-4" asp-action="Listar">Voltar</a>
        <button class="btn btn-primary rounded-pill px-4" type="submit">Confirmar</button>
    </div>
</form>
