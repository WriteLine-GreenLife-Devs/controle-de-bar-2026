@{
    Layout = "_Layout";
    ViewBag.Titulo = "Mesas";
}

@model List<ListarMesaViewModel>;

<a class="btn btn-outline-primary rounded-pill px-4 mb-3" asp-action="Cadastrar">Cadastrar Mesa</a>

@if (TempData["MensagemErro"] is string mensagemErro)
{
    <div class="alert alert-danger" role="alert">@mensagemErro</div>
}

@if (Model.Count == 0)
{
    <div class="alert alert-primary" role="alert">Nenhuma mesa cadastrada.</div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-3">
        @foreach (ListarMesaViewModel mesa in Model)
        {
            <div class="col">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between mb-3">
                            <h5 class="card-title">Mesa @mesa.Numero</h5>
                            <span class="badge @(mesa.Status == StatusMesa.Livre ? "text-bg-success" : "text-bg-warning")">@mesa.Status.GetDisplayName()</span>
                        </div>
                        <p class="card-text">@mesa.Lugares lugares</p>
                        <div class="d-flex gap-2 justify-content-end">
                            <a class="btn btn-outline-primary btn-sm rounded-pill px-3" asp-action="Editar" asp-route-id="@mesa.Id">Editar</a>
                            <a class="btn btn-outline-primary btn-sm rounded-pill px-3" asp-action="Excluir" asp-route-id="@mesa.Id">Excluir</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
